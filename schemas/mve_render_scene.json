{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MVE visible scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "frame", "width", "height", "points", "segments", "style"],
  "properties": {
    "schema": {"const": "mve-scene-v1"},
    "frame": {"const": "pixel_topleft_xy"},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "style": {"enum": ["thin", "bold"]},
    "points": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^[A-Za-z][A-Za-z0-9_]{0,40}$": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "items": {"type": "number", "minimum": 0}
      }}
    },
    "segments": {
      "type": "array", "items": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "items": {"type": "string"}
      }
    }
  }
}
