{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oae-mve-grounded-card-v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "oae-mve-grounded-card-v2"
    },
    "job": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "object"
    },
    "status": {
      "enum": [
        "grounded",
        "ungrounded",
        "contradictory",
        "underpowered"
      ]
    },
    "lifecycle": {
      "const": "preliminary"
    },
    "proposal": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^p[01]:[1-3]$"
          },
          "feature_tag": {
            "enum": [
              "histogram_peak",
              "histogram_tail",
              "spacing_gap",
              "point_cluster",
              "void",
              "symmetry_axis",
              "spiral_arm",
              "curve_shape",
              "density_gradient",
              "intersection"
            ]
          },
          "region": {
            "enum": [
              "whole",
              "top_left",
              "top_center",
              "top_right",
              "middle_left",
              "middle_center",
              "middle_right",
              "bottom_left",
              "bottom_center",
              "bottom_right"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "feature_tag",
          "region",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "grounded",
            "ungrounded",
            "contradictory"
          ]
        },
        "reason": {
          "type": "null"
        },
        "grounded": {
          "type": "boolean"
        },
        "contradictory": {
          "type": "boolean"
        },
        "citations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "job": {
          "type": "string"
        },
        "observations_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "status",
        "reason",
        "grounded",
        "contradictory",
        "citations",
        "job",
        "observations_sha256"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unavailable",
            "underpowered",
            "stage1_only"
          ]
        },
        "inferential": {
          "const": false
        }
      },
      "required": [
        "status",
        "inferential"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "job",
    "hypothesis",
    "status",
    "lifecycle",
    "proposal",
    "observations",
    "assessment",
    "check",
    "sha256"
  ],
  "additionalProperties": false
}
