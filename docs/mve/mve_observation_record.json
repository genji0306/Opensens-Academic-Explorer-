{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oae-mve-observation-v3",
  "title": "MVE observation record (oae-mve-observation-v3)",
  "description": "Authoritative schema (docs/mve/ holds a derived copy). One diagram, one record, five evidence classes. Structural rules live here; referential integrity, uniqueness across arrays, evidence authorisation (docs/mve/MVE_PLAN.md §4a table) and stage invariants live in mve/record.py's semantic validator. Older schema versions are rejected, not migrated (nothing was produced under them). Every evidence item carries `depends_on`; invalidation is transitive over that graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "content_hash",
    "revision",
    "stage",
    "versions",
    "image",
    "domain",
    "problem",
    "entities",
    "observations",
    "measurements",
    "derivations",
    "assumptions",
    "judgments",
    "decisions",
    "formal",
    "events",
    "provenance"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^(ent|obs|mea|der|asm|jud|dec|prop|evt|prm|ndg|goal|txt|geo)_[0-9]{1,6}$"
    },
    "unit01": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "description": "ids this item was computed from; transitive invalidation follows this field everywhere"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "Collinear",
        "Concyclic",
        "Parallel",
        "Perpendicular",
        "EqualLength",
        "EqualAngle",
        "Midpoint",
        "SBetween",
        "RightAngle",
        "Distinct",
        "NotCollinear",
        "AngleValue",
        "LengthValue",
        "Tangent",
        "Bisects",
        "Intersect",
        "InsideCircle",
        "Crossing",
        "OverStrand",
        "UnderStrand",
        "Components",
        "Connected"
      ],
      "description": "Registry v1 (mve/registry/predicates_v1.json) fixes arity, argument kinds/order and degeneracy per predicate. P1 active rows (frozen): Collinear, Concyclic, Parallel, Perpendicular, EqualLength, EqualAngle, Midpoint, SBetween (strict betweenness), RightAngle, plus the nondegeneracy predicates Distinct and NotCollinear. Everything else is registered but inactive until its row is frozen."
    },
    "exact": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_+\\-*/^() .√π]{1,80}$",
      "description": "exact-expression convention: integers, rationals a/b, sqrt(n) or √n, π, and + - * / ^ over them; numeric `value` is its float evaluation"
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pred",
        "args"
      ],
      "properties": {
        "pred": {
          "$ref": "#/$defs/predicate"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 6,
          "description": "entity ids (or binder names inside `problem`) in registry order"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_exact": {
          "anyOf": [
            {
              "$ref": "#/$defs/exact"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "deg",
            "rad",
            "px",
            "px_normalized",
            "ratio",
            "count",
            null
          ]
        }
      },
      "if": {
        "properties": {
          "pred": {
            "enum": [
              "AngleValue",
              "LengthValue",
              "Components"
            ]
          }
        }
      },
      "then": {
        "required": [
          "value",
          "unit"
        ]
      }
    },
    "sourced_proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "proposition",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "proposition": {
          "$ref": "#/$defs/proposition"
        },
        "source": {
          "$ref": "#/$defs/id",
          "description": "a txt_N id (problem text span) or geo_N (ground-truth artifact)"
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "oae-mve-observation-v3"
    },
    "record_id": {
      "$ref": "#/$defs/sha256",
      "description": "EXECUTION identity: sha256(content_hash + perceiver model + prompt sha + provenance.request_nonce). Distinct runs on identical content get distinct record_ids."
    },
    "content_hash": {
      "$ref": "#/$defs/sha256",
      "description": "DETERMINISTIC mathematical identity: sha256 of the canonical JSON of {image.sha256, problem, entities with source=ground_truth, versions.predicate_registry}. Synthetic identity = generator id + seed + registry version, and two generations with equal seed must yield equal content_hash."
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "ground_truth",
        "ingested",
        "perceived",
        "measured",
        "derived",
        "formalized",
        "proved",
        "reviewed"
      ],
      "description": "stage invariants (semantic validator): ground_truth/ingested need no perceiver provenance and no measurement contract; perceived requires observations and perceiver provenance; measured requires versions.measurement_contract; formalized requires formal.ir_sha256 and lean_lock_sha; proved requires formal.proof.ok"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_sha",
        "predicate_registry",
        "measurement_contract",
        "classifier_weights",
        "label_set",
        "calibration_lock"
      ],
      "properties": {
        "code_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "predicate_registry": {
          "type": "string"
        },
        "measurement_contract": {
          "type": [
            "string",
            "null"
          ],
          "description": "null before a fitted contract exists (ground_truth / ingested / perceived stages)"
        },
        "classifier_weights": {
          "type": [
            "string",
            "null"
          ]
        },
        "label_set": {
          "type": [
            "string",
            "null"
          ],
          "description": "sha256 of the labels.jsonl snapshot the lock was fit on"
        },
        "calibration_lock": {
          "type": [
            "string",
            "null"
          ]
        },
        "lean_toolchain": {
          "type": [
            "string",
            "null"
          ]
        },
        "lean_lock_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "width",
        "height",
        "source",
        "track",
        "eval_task"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "pattern": "^(synthetic:[a-z0-9_-]+:seed[0-9]+|benchmark:[a-z0-9_-]+:[A-Za-z0-9_-]+|atlas:[a-z0-9_/-]+|user:[0-9a-f]{8})$"
        },
        "track": {
          "type": "string",
          "enum": [
            "appearance_only",
            "annotated_problem"
          ]
        },
        "eval_task": {
          "type": "string",
          "enum": [
            "appearance",
            "annotation_reading",
            "problem_understanding",
            "none"
          ],
          "description": "which of the three scored tasks this record belongs to; scored apart"
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hidden",
            "visible"
          ],
          "properties": {
            "hidden": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "generator_premises",
                  "truth_classes",
                  "answer",
                  "reference_paths",
                  "consequences"
                ]
              }
            },
            "visible": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "labels",
                  "stated_givens",
                  "problem_text"
                ]
              }
            }
          },
          "description": "what the inference stages may read; ground-truth artifacts are never mounted for A1–A3"
        },
        "ground_truth_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ],
          "description": "geo_N id of the truth artifact (stored out of band, referenced by sha in `truth`)"
        },
        "truth": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "candidate_universe_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "split": {
              "type": "string",
              "enum": [
                "fit",
                "train",
                "calibration",
                "evaluation",
                "sealed"
              ]
            },
            "family": {
              "type": "string"
            }
          }
        },
        "ocr": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "engine": {
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "frame": {
              "const": "pixel_topleft_xy"
            },
            "transform_to_entity_frame": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 6,
              "maxItems": 6,
              "description": "affine [a,b,c,d,e,f] mapping OCR frame to entity frame; identity when equal"
            }
          }
        }
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "euclidean_plane",
        "solid",
        "function_plot",
        "chart",
        "graph",
        "knot",
        "surface",
        "braid",
        "unsupported"
      ]
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texts",
        "binders",
        "premises",
        "nondegeneracy",
        "goal"
      ],
      "properties": {
        "texts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256",
              "span"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "span": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "description": "addressable text sources txt_N (sha of the full text + char span)"
        },
        "binders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_']*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Point",
                  "Line",
                  "Circle",
                  "Real",
                  "Nat"
                ]
              },
              "entity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "premises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourced_proposition"
          },
          "description": "stated givens, ids prm_N, each with a txt_N or geo_N source"
        },
        "nondegeneracy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourced_proposition"
          },
          "description": "ids ndg_N; predicates Distinct / NotCollinear only (semantic validator)"
        },
        "goal": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "proposition",
            "source"
          ],
          "properties": {
            "id": {
              "const": "goal_1"
            },
            "kind": {
              "type": "string",
              "enum": [
                "prove",
                "compute",
                "construct"
              ]
            },
            "proposition": {
              "$ref": "#/$defs/proposition"
            },
            "source": {
              "$ref": "#/$defs/id"
            }
          },
          "description": "null means no goal: the formalizer emits an assumption record, never a theorem. The goal is a SOURCE for formal.propositions[role=goal]; it is never an established hypothesis."
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "geometries"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "point",
              "segment",
              "line",
              "ray",
              "circle",
              "arc",
              "polygon",
              "curve",
              "crossing",
              "strand",
              "region",
              "tick",
              "arrow",
              "angle_mark",
              "right_angle_mark"
            ]
          },
          "geometries": {
            "type": "array",
            "minItems": 1,
            "description": "one geometry per evidence source: perceiver call 1, call 2, image measurement, ground truth. Each is addressable (geo_N) so measurements can say which coordinates they used.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source",
                "frame",
                "params"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "perceiver_call_1",
                    "perceiver_call_2",
                    "image_measurement",
                    "ground_truth"
                  ]
                },
                "frame": {
                  "const": "pixel_topleft_xy"
                },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "point [x,y]; segment/ray/line [x1,y1,x2,y2]; circle [cx,cy,r]; arc [cx,cy,r,a0,a1]; polygon/curve [x1,y1,...] (≥3 points); crossing [x,y]; strand: polyline [x1,y1,...] with gaps encoded as NaN-free segments list in `pieces`; region: polygon; marks [x,y,w,h]"
                },
                "pieces": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "description": "strand only: visible sub-polylines, gaps preserved as breaks between pieces (over/under evidence)"
                },
                "localization_sigma_px": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "description": "estimated coordinate uncertainty; required for image_measurement"
                },
                "occluded": {
                  "type": "boolean"
                }
              }
            }
          },
          "on": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "call",
          "kind",
          "confidence",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "call": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "kind": {
            "type": "string",
            "enum": [
              "proposition",
              "free_text",
              "not_determinable",
              "refusal",
              "malformed"
            ]
          },
          "proposition": {
            "$ref": "#/$defs/proposition"
          },
          "free_text": {
            "type": "string",
            "maxLength": 600
          },
          "confidence": {
            "$ref": "#/$defs/unit01"
          },
          "depends_on": {
            "$ref": "#/$defs/deps",
            "description": "the geo_N ids of the call's own geometries"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "proposition"
                }
              }
            },
            "then": {
              "required": [
                "proposition"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "free_text"
                }
              }
            },
            "then": {
              "required": [
                "free_text"
              ]
            }
          }
        ]
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposition",
          "method",
          "kernel",
          "outcome",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "proposition": {
            "$ref": "#/$defs/proposition"
          },
          "method": {
            "type": "string",
            "enum": [
              "coordinate_consistency",
              "image_measurement",
              "mark_association"
            ]
          },
          "kernel": {
            "type": "string"
          },
          "residual": {
            "type": [
              "number",
              "null"
            ]
          },
          "residual_unit": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "deg",
              "px",
              "px_normalized",
              "ratio",
              null
            ]
          },
          "normalization": {
            "type": [
              "string",
              "null"
            ],
            "description": "e.g. px_normalized = px / diagram diagonal"
          },
          "tolerance": {
            "type": [
              "number",
              "null"
            ]
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "description": "propagated from geometries[].localization_sigma_px"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "consistent",
              "inconsistent",
              "near_degenerate",
              "degenerate",
              "unmeasurable"
            ]
          },
          "depends_on": {
            "$ref": "#/$defs/deps",
            "description": "geo_N ids of the coordinates used (so call-1 vs call-2 vs image measurement is explicit) plus obs_N that motivated it"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "consistent",
                    "inconsistent",
                    "near_degenerate"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "residual",
                "residual_unit",
                "tolerance"
              ],
              "properties": {
                "residual": {
                  "type": "number"
                },
                "tolerance": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": [
                    "degenerate",
                    "unmeasurable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "residual": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "engine",
          "target",
          "outcome",
          "depends_on",
          "budget_s"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "engine": {
            "type": "string"
          },
          "target": {
            "$ref": "#/$defs/proposition"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "proved",
              "counterexample",
              "unknown",
              "unsupported",
              "timeout"
            ]
          },
          "trace_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "witness": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "coordinates": {
                "type": "object"
              },
              "exact": {
                "type": "boolean",
                "description": "true when validated exactly (rational/algebraic), false when numeric within declared tolerance"
              },
              "tolerance": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "budget_s": {
            "type": "number",
            "minimum": 0
          },
          "depends_on": {
            "$ref": "#/$defs/deps",
            "description": "premises used: prm_N, ndg_N, asm_N only (never mea_N)"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "proved"
                }
              }
            },
            "then": {
              "required": [
                "trace_sha256"
              ],
              "properties": {
                "trace_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "counterexample"
                }
              }
            },
            "then": {
              "required": [
                "witness"
              ],
              "properties": {
                "witness": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposition",
          "adopted_by",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "proposition": {
            "$ref": "#/$defs/proposition"
          },
          "adopted_by": {
            "type": "string",
            "pattern": "^(human:[a-z0-9_-]+|policy:[a-z0-9_-]+|text)$"
          },
          "depends_on": {
            "$ref": "#/$defs/deps",
            "minItems": 1
          }
        }
      }
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "judge",
          "target",
          "question",
          "verdict",
          "weight",
          "at",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "judge": {
            "type": "string",
            "pattern": "^(human|model|audit):[A-Za-z0-9._-]+$"
          },
          "target": {
            "$ref": "#/$defs/id"
          },
          "question": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "confirm",
              "reject",
              "not_visible",
              "unsure",
              "adopt",
              "decline",
              "label"
            ]
          },
          "label": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "weight": {
            "$ref": "#/$defs/unit01"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "depends_on": {
            "$ref": "#/$defs/deps"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question_id",
          "primitive",
          "backend",
          "state_sha256",
          "input_tokens",
          "answer",
          "abstained",
          "confidence",
          "threshold_high",
          "threshold_low",
          "route",
          "lock_sha256",
          "depends_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "question_id": {
            "type": "string"
          },
          "primitive": {
            "type": "string",
            "enum": [
              "choice",
              "score",
              "noul"
            ]
          },
          "backend": {
            "type": "string"
          },
          "state_sha256": {
            "$ref": "#/$defs/sha256",
            "description": "hash of the complete serialized model input"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "answer": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "abstained": {
            "type": "boolean"
          },
          "probabilities": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/unit01"
            }
          },
          "confidence": {
            "$ref": "#/$defs/unit01"
          },
          "threshold_high": {
            "$ref": "#/$defs/unit01"
          },
          "threshold_low": {
            "$ref": "#/$defs/unit01"
          },
          "route": {
            "type": "string",
            "enum": [
              "act",
              "llm",
              "human",
              "disabled"
            ]
          },
          "audit_sample": {
            "type": "boolean"
          },
          "lock_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "depends_on": {
            "$ref": "#/$defs/deps"
          }
        }
      }
    },
    "formal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "propositions",
        "depends_on"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "none",
            "unsupported",
            "emitted",
            "typechecked",
            "proof_attempted",
            "proved",
            "counterexample"
          ]
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "mathlib",
            "leangeo",
            null
          ]
        },
        "ir_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "propositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role",
              "proposition",
              "support",
              "depends_on"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "role": {
                "type": "string",
                "enum": [
                  "hypothesis",
                  "nondegeneracy",
                  "goal"
                ]
              },
              "proposition": {
                "$ref": "#/$defs/proposition"
              },
              "support": {
                "type": "string",
                "enum": [
                  "problem_text",
                  "assumption",
                  "derived",
                  "human_confirmed",
                  "goal_source"
                ],
                "description": "authorisation (semantic validator): problem_text → depends_on ⊆ prm/ndg ids; assumption → an asm_N; derived → a der_N with outcome=proved whose target equals this proposition; human_confirmed → a jud_N with judge human:* and verdict confirm on a mea_N/obs_N carrying this proposition (model judges never authorise); goal_source → role must be goal, depends_on = [goal_1]; a goal is never an established hypothesis"
              },
              "depends_on": {
                "$ref": "#/$defs/deps",
                "minItems": 1
              }
            }
          }
        },
        "statement_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "typecheck": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "ok",
            "toolchain",
            "log_sha256"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "toolchain": {
              "type": "string"
            },
            "log_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "proof": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "prover",
            "ok",
            "axioms",
            "axiom_policy",
            "sorry_free",
            "dependency_closure_checked",
            "statement_matches_accepted",
            "budget_s",
            "log_sha256",
            "depends_on"
          ],
          "properties": {
            "prover": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "axioms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "axiom_policy": {
              "type": "string",
              "enum": [
                "mathlib_standard_only",
                "custom"
              ],
              "description": "mathlib_standard_only = propext, Classical.choice, Quot.sound"
            },
            "sorry_free": {
              "type": "boolean"
            },
            "dependency_closure_checked": {
              "type": "boolean"
            },
            "statement_matches_accepted": {
              "type": "boolean"
            },
            "budget_s": {
              "type": "number"
            },
            "log_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "depends_on": {
              "$ref": "#/$defs/deps"
            }
          }
        },
        "equivalence": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "reference",
            "level",
            "evaluator",
            "artifact_sha256",
            "variable_mapping"
          ],
          "properties": {
            "reference": {
              "type": "string"
            },
            "level": {
              "type": "string",
              "enum": [
                "structural",
                "machine_supported",
                "reviewer_judged",
                "unknown",
                "unsupported"
              ]
            },
            "evaluator": {
              "type": "string"
            },
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "variable_mapping": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "rationale": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        },
        "render_back": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "renderer",
            "realizations",
            "depends_on"
          ],
          "properties": {
            "renderer": {
              "type": "string"
            },
            "realizations": {
              "type": "string",
              "enum": [
                "one",
                "multiple",
                "none",
                "unsupported"
              ]
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "roundtrip_ok": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "depends_on": {
              "$ref": "#/$defs/deps"
            }
          }
        },
        "depends_on": {
          "$ref": "#/$defs/deps"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proved"
              }
            }
          },
          "then": {
            "required": [
              "proof",
              "statement_sha256"
            ],
            "properties": {
              "proof": {
                "type": "object",
                "properties": {
                  "ok": {
                    "const": true
                  },
                  "sorry_free": {
                    "const": true
                  },
                  "statement_matches_accepted": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "typechecked",
                  "proof_attempted",
                  "proved",
                  "counterexample"
                ]
              }
            }
          },
          "then": {
            "required": [
              "typecheck",
              "ir_sha256"
            ],
            "properties": {
              "typecheck": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "at",
          "actor",
          "kind",
          "from_revision",
          "to_revision",
          "touches"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "created",
              "perceived",
              "measured",
              "derived",
              "assumed",
              "judged",
              "decided",
              "formalized",
              "proved",
              "rendered",
              "edited",
              "invalidated",
              "ingested"
            ]
          },
          "from_revision": {
            "type": "integer",
            "minimum": 0
          },
          "to_revision": {
            "type": "integer",
            "minimum": 1
          },
          "touches": {
            "$ref": "#/$defs/deps"
          },
          "patch": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object"
            },
            "description": "RFC 6902 JSON Patch from from_revision to to_revision; required for kind=edited (replay)"
          },
          "invalidates": {
            "$ref": "#/$defs/deps",
            "description": "ids invalidated transitively via depends_on (semantic validator computes and checks)"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "edited"
            }
          }
        },
        "then": {
          "required": [
            "patch"
          ],
          "properties": {
            "patch": {
              "type": "array"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perceiver_model",
        "perceiver_calls",
        "prompt_sha256",
        "raw_response_sha256",
        "request_nonce",
        "created_at",
        "cost_usd"
      ],
      "properties": {
        "perceiver_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "perceiver_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_response_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "request_nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "retained so record_id is recomputable"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "execution metadata; excluded from content_hash"
        },
        "wave_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cell_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "ledger_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}